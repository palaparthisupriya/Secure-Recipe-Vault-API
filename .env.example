# Server Config
PORT=3000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Config
# By default, uses SQLite for zero-setup execution.
# For PostgreSQL in Docker or local instance:
# DATABASE_URL=postgresql://postgres:changeme@localhost:5432/recipe_vault
DATABASE_URL=sqlite:///./recipe_vault.db

# Security Keys
JWT_ACCESS_SECRET=super_secret_jwt_access_signing_key_recipe_vault_2026_secure
JWT_REFRESH_SECRET=super_secret_jwt_refresh_signing_key_recipe_vault_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Config
RATE_LIMIT_FAILED_LOGINS=5
RATE_LIMIT_WINDOW_SECONDS=300

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict
